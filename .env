# Email (SMTP via nodemailer). When SMTP_HOST/USER/PASS unset, src/server/email.ts
# logs payloads to console instead of sending. Most providers use port 587 + STARTTLS
# (leave SMTP_SECURE unset/false); use 465 + SMTP_SECURE=true for TLS-on-connect.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# EMAIL_FROM=IKF Pathway 360 <pathway@indiakhelofootball.com>
# ADVISOR_EMAIL=advisor@indiakhelofootball.com
# APP_BASE_URL=http://localhost:5173

# Cron auth — used by /api/cron/* endpoints to gate writes.
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` automatically when
# this env var is set on the project. For manual triggers: curl with the same header.
# CRON_SECRET=replace-with-a-long-random-string
