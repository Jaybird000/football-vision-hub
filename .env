# Postgres — svapp.us (currently behind Cloudflare Tunnel; not reachable without cloudflared)
# DATABASE_URL=postgresql://ikf_360_owner:2Og9LntowHN2PUyNSv02aWZJxsIEJd68@db.svapp.us:5432/ikf_360?sslmode=require

# Email (SMTP2GO HTTP API). Workers-compatible (no raw TCP). Get API key at
# https://app.smtp2go.com/settings/apikeys. When SMTP2GO_API_KEY unset,
# src/server/email.ts logs payloads to console instead of sending.
# SMTP2GO_API_KEY=api-xxx
# EMAIL_FROM=IKF Pathway 360 <pathway@indiakhelofootball.com>
# ADVISOR_EMAIL=advisor@indiakhelofootball.com
# APP_BASE_URL=http://localhost:5173

# Cloudflare R2 object storage for assessment uploads (replaces local disk).
# Bucket is account-scoped (no global namespace). Generate S3 API credentials
# at Cloudflare dashboard → R2 → Manage R2 API Tokens → Object Read & Write.
# R2_ACCOUNT_ID=d628e95a0bbafdd45ff52ca1189daae5
# R2_BUCKET=ikf-pathway-uploads
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Cron auth — used by /api/cron/* endpoints to gate writes.
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` automatically when
# this env var is set on the project. For manual triggers: curl with the same header.
# CRON_SECRET=replace-with-a-long-random-string
